# Generated worksheet output — rebuildable from the ambar-worksheet plugin.
# Deliberately not versioned: binaries don't diff, and every regeneration
# would add another full copy to history.
*.pdf
*.pdf#
*.tmp
~$*
.DS_Store

# Generated worksheet illustrations
**/assets/

# ...but everything under sources/ IS versioned: school sample papers, the SOF
# topic deep-dives and cheat sheets, handwriting. Reference material, not output —
# the one place binaries earn their keep.
!sources/**

# Plugin build artefacts
*.plugin

# Superseded: the old in-folder copy of the skill, now shipped as the plugin
.skills/

# Notebook / textbook photos stay local — originals live in the
# Ambar Worksheet folder, where create-worksheet reads them.
sources/notebook-photos/
